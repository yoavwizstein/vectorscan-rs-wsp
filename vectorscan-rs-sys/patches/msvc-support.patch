diff --git a/CMakeLists.txt b/CMakeLists.txt
index add54a48..8ffc210f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -214,6 +214,13 @@ if (CORRECT_PCRE_VERSION AND PCRE_BUILD_SOURCE AND BUILD_STATIC_LIBS)
 endif()
 
 set(RAGEL_C_FLAGS "-Wno-unused -funsigned-char")
+# clang-cl ignores GNU-style -funsigned-char (warns "unknown argument ignored").
+# The Ragel parser (Parser.rl: alphtype unsigned char) then reads pattern bytes
+# >= 0x80 as negative under the MSVC default signed char and rejects valid
+# regexes ("Parse error at index N"). Use the clang-cl-honored spelling here.
+if (MSVC)
+    set(RAGEL_C_FLAGS "-Wno-unused -Xclang -fno-signed-char")
+endif()
 
 set_source_files_properties(
     src/parser/Parser.cpp
@@ -1217,3 +1224,12 @@ option(BUILD_DOC "Build the Hyperscan documentation (default TRUE)" TRUE)
 if(BUILD_DOC)
     add_subdirectory(doc/dev-reference)
 endif()
+
+if (MSVC AND FAT_RUNTIME)
+    get_property(_fat_rename_targets GLOBAL PROPERTY FAT_RENAME_TARGETS)
+    foreach (_lib hs hs_runtime)
+        if (TARGET ${_lib} AND _fat_rename_targets)
+            add_dependencies(${_lib} ${_fat_rename_targets})
+        endif()
+    endforeach()
+endif()
diff --git a/cmake/build_wrapper.cmake b/cmake/build_wrapper.cmake
index 80ea722f..62c716fc 100644
--- a/cmake/build_wrapper.cmake
+++ b/cmake/build_wrapper.cmake
@@ -1,9 +1,24 @@
 function(add_fat_component component objects compile_flags sources isPIC)
     set(BUILD_WRAPPER "${PROJECT_SOURCE_DIR}/cmake/build_wrapper.sh")
     add_library(${objects} OBJECT ${sources})
-    set_target_properties(${objects} PROPERTIES
-        COMPILE_FLAGS "${compile_flags}"
-	POSITION_INDEPENDENT_CODE ${isPIC}
-        RULE_LAUNCH_COMPILE "${BUILD_WRAPPER} ${component} ${CMAKE_MODULE_PATH}/keep.syms.in"
-        )
+    if (MSVC)
+        set_target_properties(${objects} PROPERTIES
+            COMPILE_FLAGS "${compile_flags}"
+            POSITION_INDEPENDENT_CODE ${isPIC})
+        find_program(POWERSHELL_EXE NAMES powershell pwsh REQUIRED)
+        add_custom_target(rename_${objects} ALL
+            COMMAND ${POWERSHELL_EXE} -NoProfile -ExecutionPolicy Bypass -File
+                    ${PROJECT_SOURCE_DIR}/cmake/fat_rename.ps1
+                    ${component} ${CMAKE_MODULE_PATH}/keep.syms.in
+                    ${CMAKE_BINARY_DIR}/CMakeFiles/${objects}.dir
+            COMMENT "COFF symbol rename for ${component} fat-runtime variant"
+            VERBATIM)
+        add_dependencies(rename_${objects} ${objects})
+        set_property(GLOBAL APPEND PROPERTY FAT_RENAME_TARGETS rename_${objects})
+    else ()
+        set_target_properties(${objects} PROPERTIES
+            COMPILE_FLAGS "${compile_flags}"
+            POSITION_INDEPENDENT_CODE ${isPIC}
+            RULE_LAUNCH_COMPILE "${BUILD_WRAPPER} ${component} ${CMAKE_MODULE_PATH}/keep.syms.in")
+    endif ()
 endfunction()
